# Jev chooses every click.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# The LLM plans the step and writes typed text. Any OpenAI-compatible chat/completions endpoint.
# Default: Claude Sonnet through Anthropic's OpenAI-compatible endpoint (ANTHROPIC_API_KEY also works as the key).
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL=claude-sonnet-5
# Optional: a smaller, faster model just for typing field values.
# LLM_TEXT_MODEL=claude-haiku-4-5
# Optional: JSON merged into every request. A null value removes a default field.
# LLM_EXTRA_BODY='{"max_tokens":null,"max_completion_tokens":2048}'

# Other providers, same three variables:
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1       LLM_MODEL=gpt-4.1
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1    LLM_MODEL=anthropic/claude-sonnet-5
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1       LLM_MODEL=qwen3   LLM_API_KEY=ollama
